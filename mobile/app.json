{
  "expo": {
    "name": "SkinCare AI",
    "slug": "skincare-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "skincare-ai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skincare.ai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFCF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.skincare.ai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkinCare AI to access your photos for skin analysis",
          "cameraPermission": "Allow SkinCare AI to take photos for skin analysis"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
