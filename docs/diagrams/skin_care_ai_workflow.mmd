---
flowchart TD

    User(["User"])

    subgraph Clients["Client Surfaces"]
        direction LR
        Web["Web App<br/>Streamlit"]
        Mobile["Mobile App<br/>React Native · Expo"]
    end

    User --> Web
    User --> Mobile

    Web --> ApiLayer
    Mobile --> ApiLayer

    subgraph ApiLayer["API Layer · FastAPI"]
        direction TB
        Routes["routes/<br/>analyze · products · conditions"]
        Services["services/<br/>analyzer_service · product_service"]
        CORS["CORS · run.py / uvicorn"]
        Routes --> Services --> CORS
    end

    CORS --> Engine

    subgraph Engine["Inference Engine"]
        direction TB
        Analyzer["SkinAnalyzer<br/>predict.py"]
        Preprocess["Preprocess<br/>224×224 · normalize"]
        Predict["Concern predict<br/>5x sigmoid + thresholds"]
        FaceGate{"Face found?"}
        Output["concerns + uncertainty"]
        Analyzer --> Preprocess --> Predict --> FaceGate
        FaceGate -->|"yes"| Output
        FaceGate -->|"no"| Warn["Retake photo<br/>no products returned"]
    end

    Output --> Rules

    subgraph Reco["Recommendation Engine"]
        direction TB
        Rules["condition_rules.py<br/>concerns + skin-type → ingredients"]
        Scoring["scoring.py<br/>ingredient + skin-type match"]
        Engine2["engine.py<br/>deterministic shortlist"]
        SLMTitle["SLM Layer  optional"]
        SLMCfg["config.py"]
        SLMEng["engine.py<br/>Qwen2.5-1.5B-Instruct"]
        SLMRec["recommender.py<br/>prompt · JSON · guardrails"]
        Final["Ranked recs + reasons + AM/PM routine"]
        Rules --> Scoring --> Engine2
        Engine2 --> SLMRec
        SLMCfg --> SLMEng --> SLMRec
        SLMRec --> Final
    end

    Final --> Web
    Final --> Mobile

    Catalog[(Product Catalog<br/>unified_products.csv)]
    Engine2 -. filter .-> Catalog
    Catalog -.-> Scoring

    subgraph Data["Data Pipeline"]
        direction TB
        Src1["ForEveryNG"]
        Src2["Jeevee"]
        Src3["Oriflame"]
        Merge["merge_sources.py"]
        Dedup["deduplicator.py<br/>fuzzy dedup"]
        Enrich["enricher.py<br/>ingredient · skin-type · concern"]
        Unified["unified_products.csv"]
        Mappings["data/mappings/<br/>keyword maps"]
        Src1 --> Merge
        Src2 --> Merge
        Src3 --> Merge
        Merge --> Dedup --> Enrich --> Unified
        Enrich --> Mappings
    end

    Unified --> Catalog
    Mappings --> Enrich

    subgraph ML["ML Training"]
        direction TB
        Imgs[/"vision manifests<br/>train · validation · test"/]
        Dataset["concern_dataset.py<br/>manifest tf.data"]
        Model["concern_model.py<br/>EfficientNetB0 + 5x sigmoid"]
        Train["train_concern.py<br/>Phase A frozen → Phase B fine-tune"]
        Eval["evaluate_concern.py<br/>PR/ROC-AUC + thresholds"]
        Weights["weights.h5"]
        Imgs --> Dataset --> Model --> Train --> Eval --> Weights
    end

    Weights --> Analyzer

    subgraph CLI["Pipeline CLI"]
        direction TB
        Run["run_pipeline.py<br/>--step data / inference / all"]
        StepData["--step data"]
        StepInf["--step inference"]
        Tests["scripts/<br/>test_predict_integration · test_slm_logic"]
        Run --> StepData
        Run --> StepInf
        Run --> Tests
    end

    StepData -.-> Merge
    StepInf -.-> Analyzer
    Tests -.-> Analyzer

